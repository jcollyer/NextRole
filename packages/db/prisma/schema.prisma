// NextRole Prisma schema
//
// Models:
//   - User / Account / Session / VerificationToken: the NextAuth (Auth.js) v5
//     adapter models. The User table is the canonical record for a person in
//     your app.
//
// NextRole keeps Auth.js tables alongside the job-search CRM domain models so
// user-owned companies, jobs, applications, scans, and signals can grow from
// single-user MVP into multi-user support later.

generator client {
  provider      = "prisma-client-js"
  // Include the Vercel/Lambda Linux engine alongside the local native engine
  // so the same generated client runs locally and on serverless hosts.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// NextAuth (Auth.js) models
// ----------------------------------------------------------------------------

model User {
  id                 String         @id @default(cuid())
  name               String?
  email              String?        @unique
  emailVerified      DateTime?
  image              String?
  workArrangements   String[]       @default([])
  preferredLocations String[]       @default([])
  roleFamilies       String[]       @default([])
  includedTitleTerms String[]       @default([])
  excludedTitleTerms String[]       @default([])
  seniorityLevels    String[]       @default([])
  accounts           Account[]
  sessions           Session[]
  companies          Company[]
  jobs               Job[]
  applications       Application[]
  scanHistory        ScanHistory[]
  hiringSignals      HiringSignal[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----------------------------------------------------------------------------
// NextRole domain models
// ----------------------------------------------------------------------------

enum CompanyPriority {
  LOW
  MEDIUM
  HIGH
  DREAM
}

enum CompanyStatus {
  TRACKING
  WATCHING
  APPLIED
  INTERVIEWING
  PAUSED
  ARCHIVED
}

enum JobStatus {
  NEW
  SAVED
  ANALYZED
  APPLIED
  DISMISSED
  ARCHIVED
}

enum ApplicationStatus {
  SAVED
  APPLIED
  RECRUITER_SCREEN
  HIRING_MANAGER
  TECHNICAL_INTERVIEW
  FINAL_INTERVIEW
  OFFER
  REJECTED
  ARCHIVED
}

enum ScanStatus {
  SUCCESS
  EMPTY
  FAILED
}

enum HiringSignalType {
  FUNDING
  HIRING_ANNOUNCEMENT
  PRODUCT_LAUNCH
  FOUNDER_POST
  NEW_OFFICE
  LAYOFF_RISK
  OTHER
}

model Company {
  id            String          @id @default(cuid())
  userId        String
  name          String
  website       String?
  careersUrl    String?
  category      String?
  stage         String?
  location      String?
  remotePolicy  String?
  fundingStatus String?
  notes         String?         @db.Text
  priority      CompanyPriority @default(MEDIUM)
  status        CompanyStatus   @default(TRACKING)
  lastScannedAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs          Job[]
  applications  Application[]
  scanHistory   ScanHistory[]
  hiringSignals HiringSignal[]

  @@unique([userId, name])
  @@index([userId, priority])
  @@index([userId, status])
}

model Job {
  id                String    @id @default(cuid())
  userId            String
  companyId         String
  title             String
  url               String?
  location          String?
  remotePolicy      String?
  description       String?   @db.Text
  source            String?
  dateFound         DateTime  @default(now())
  isNew             Boolean   @default(true)
  discoveredByScan  Boolean   @default(false)
  isCurrent         Boolean   @default(true)
  matchScore        Int?
  aiSummary         String?   @db.Text
  aiFitReason       String?   @db.Text
  extractedKeywords String[]  @default([])
  outreachAngle     String?   @db.Text
  status            JobStatus @default(NEW)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([userId, companyId, url])
  @@index([userId, status])
  @@index([userId, isNew])
  @@index([companyId])
  @@index([companyId, discoveredByScan, isCurrent])
}

model Application {
  id               String            @id @default(cuid())
  userId           String
  companyId        String
  jobId            String?
  status           ApplicationStatus @default(SAVED)
  appliedAt        DateTime?
  lastFollowUpAt   DateTime?
  nextFollowUpAt   DateTime?
  recruiterContact String?
  referralContact  String?
  notes            String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, nextFollowUpAt])
  @@index([companyId])
  @@index([jobId])
}

model ScanHistory {
  id           String     @id @default(cuid())
  userId       String
  companyId    String
  status       ScanStatus
  jobsFound    Int        @default(0)
  jobsMatched  Int        @default(0)
  strategy     String?
  errorMessage String?    @db.Text
  scannedAt    DateTime   @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, scannedAt])
  @@index([companyId])
}

model HiringSignal {
  id         String           @id @default(cuid())
  userId     String
  companyId  String
  type       HiringSignalType @default(OTHER)
  title      String
  sourceUrl  String?
  signalDate DateTime?
  notes      String?          @db.Text
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([companyId])
}
